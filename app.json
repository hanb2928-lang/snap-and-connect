{
  "expo": {
    "name": "숏커넥트",
    "slug": "snap-and-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snapconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapconnect.app"
    },
    "android": {
      "package": "com.snapconnect.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0f1e"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "supabaseUrl": "https://pnlyrodbiqlpwduuzrsp.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBubHlyb2RiaXFscHdkdXV6cnNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MTA0NDIsImV4cCI6MjEwMjI4NjQ0Mn0.CP2hnNB5UfPQh6kxUvIUzEkd8q0gby1ukLCCkh5ri38"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", [
      "expo-image-picker",
      {
        "photosPermission": "Allow 숏커넥트 to access your photos to upload and analyze them."
      }
    ], [
      "expo-camera",
      {
        "cameraPermission": "Allow 숏커넥트 to access your camera to capture and analyze photos.",
        "shutterSound": false
      }
    ], [
      "expo-media-library",
      {
        "photosPermission": "Allow 숏커넥트 to save template cards to your photo gallery.",
        "savePhotosPermission": "Allow 숏커넥트 to save template cards to your photo gallery."
      }
    ], [
      "expo-system-ui",
      {
        "edgeToEdge": true
      }
    ]],
    "experiments": {
      "typedRoutes": true
    }
  }
}
